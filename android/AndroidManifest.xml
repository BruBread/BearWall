<?xml version="1.0" encoding="utf-8"?>
<!-- BearWall kiosk: the projector's home screen. A fullscreen WebView shows http://127.0.0.1:8080/wall,
     served by the app's own small web server (Server.java), which also serves the control page to your laptop. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bearwall"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:label="BearWall"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- HOME: Android starts it at boot and returns to it on the Home key (and when HDMI is unplugged) -->
        <activity
            android:name=".WallActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- pairing your laptop: only the adb shell holds DUMP, so only your PC can set the key -->
        <receiver android:name=".PairReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.bearwall.PAIR" />
            </intent-filter>
        </receiver>

        <!-- a clean shutdown leaves a note, so the next boot can tell a power cut from a normal restart -->
        <receiver android:name=".ShutdownReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
